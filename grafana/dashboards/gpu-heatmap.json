{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "description": "Heatmap showing GPU utilization patterns over time - darker = higher utilization",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "dark-orange",
                "value": 20
              },
              {
                "color": "dark-yellow",
                "value": 40
              },
              {
                "color": "dark-green",
                "value": 60
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 20,
      "options": {
        "calculate": false,
        "cellGap": 2,
        "cellValues": {
          "unit": "percent"
        },
        "color": {
          "exponent": 0.5,
          "fill": "dark-red",
          "mode": "scheme",
          "reverse": false,
          "scale": "exponential",
          "scheme": "RdYlGn",
          "steps": 128
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-9
        },
        "legend": {
          "show": true
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false,
          "unit": "short"
        }
      },
      "pluginVersion": "10.2.2",
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "format": "time_series",
          "legendFormat": "GPU {{gpu}} - {{instance}}",
          "refId": "A"
        }
      ],
      "title": "GPU Utilization Heatmap - Burn Visualization",
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "destinationType": "number",
                "targetField": "Value"
              }
            ],
            "fields": {}
          }
        }
      ],
      "type": "heatmap"
    },
    {
      "datasource": "Prometheus",
      "description": "Status matrix showing current state of all GPUs",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "center",
            "displayMode": "color-background"
          },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "dark-orange",
                "value": 20
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "green",
                "value": 60
              },
              {
                "color": "dark-green",
                "value": 80
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 21,
      "options": {
        "footer": {
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "10.2.2",
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "GPU Status Matrix",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "service": true
            },
            "indexByName": {
              "Time": 0,
              "Value": 4,
              "gpu": 1,
              "instance": 2,
              "modelName": 3
            },
            "renameByName": {
              "Value": "Utilization %",
              "gpu": "GPU",
              "instance": "Instance",
              "modelName": "Model"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": "Prometheus",
      "description": "Timeline showing when GPUs are idle vs active",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "lineWidth": 1
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "dark-red",
                  "index": 0,
                  "text": "Idle"
                },
                "1": {
                  "color": "dark-green",
                  "index": 1,
                  "text": "Active"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "dark-green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 22,
      "options": {
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "never",
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "10.2.2",
      "targets": [
        {
          "expr": "(DCGM_FI_DEV_GPU_UTIL > 20) * 1",
          "legendFormat": "GPU {{gpu}} - {{instance}}",
          "refId": "A"
        }
      ],
      "title": "GPU Activity Timeline (Idle vs Active)",
      "type": "state-timeline"
    },
    {
      "datasource": "Prometheus",
      "description": "Distribution of GPU utilization values",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "id": 23,
      "options": {
        "bucketOffset": 0,
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "pluginVersion": "10.2.2",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(DCGM_FI_DEV_GPU_UTIL[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(DCGM_FI_DEV_GPU_UTIL[5m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(DCGM_FI_DEV_GPU_UTIL[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "GPU Utilization Distribution",
      "type": "histogram"
    },
    {
      "datasource": "Prometheus",
      "description": "Hours in each utilization band",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 100,
            "gradientMode": "none",
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "h"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Idle (0-20%)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "dark-red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Low (20-40%)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "dark-orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Medium (40-60%)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "dark-yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Good (60-80%)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Optimal (80-100%)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "dark-green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "id": 24,
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "10.2.2",
      "targets": [
        {
          "expr": "sum(count_over_time((DCGM_FI_DEV_GPU_UTIL < 20)[24h:])) / 60",
          "legendFormat": "Idle (0-20%)",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time((DCGM_FI_DEV_GPU_UTIL >= 20 and DCGM_FI_DEV_GPU_UTIL < 40)[24h:])) / 60",
          "legendFormat": "Low (20-40%)",
          "refId": "B"
        },
        {
          "expr": "sum(count_over_time((DCGM_FI_DEV_GPU_UTIL >= 40 and DCGM_FI_DEV_GPU_UTIL < 60)[24h:])) / 60",
          "legendFormat": "Medium (40-60%)",
          "refId": "C"
        },
        {
          "expr": "sum(count_over_time((DCGM_FI_DEV_GPU_UTIL >= 60 and DCGM_FI_DEV_GPU_UTIL < 80)[24h:])) / 60",
          "legendFormat": "Good (60-80%)",
          "refId": "D"
        },
        {
          "expr": "sum(count_over_time((DCGM_FI_DEV_GPU_UTIL >= 80)[24h:])) / 60",
          "legendFormat": "Optimal (80-100%)",
          "refId": "E"
        }
      ],
      "title": "Time Spent in Each Utilization Band (24h)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 27,
  "style": "dark",
  "tags": ["gpu", "heatmap", "utilization", "burn"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "timezone": "browser",
  "title": "GPU Utilization Heatmap",
  "uid": "gpu-heatmap",
  "version": 1
}
