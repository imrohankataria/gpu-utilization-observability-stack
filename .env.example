# Example Environment Configuration
# Copy this file to .env and customize for your environment

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-in-production

# GPU Cost Configuration (used in dashboards)
# Adjust based on your cloud provider pricing
GPU_HOURLY_COST=2.0  # Default: $2/hour

# Alert Configuration
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_EMAIL_TO=ops-team@example.com
ALERT_EMAIL_FROM=alertmanager@example.com
ALERT_EMAIL_SMARTHOST=smtp.gmail.com:587

# Prometheus Configuration
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_SCRAPE_INTERVAL=15s

# Timezone
TZ=America/New_York
